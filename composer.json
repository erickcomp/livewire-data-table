{
    "name": "erickcomp/livewire-data-table",
    "type": "library",
    "description": "Provides a html/blade centric data table approach leveraging Livewire's reactiveness for a great UX.",
    "keywords": [
        "laravel",
        "framework",
        "livewire",
        "table",
        "data",
        "data-table"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.60|^13.10",
        "livewire/livewire": "^3.6|^4.0",
        "erickcomp/laravel-raw-blade-components": "^3.0",
        "phpgt/dom": "^4.2"
    },
    "conflict": {
        "phpgt/cssxpath": "<1.1.2 || >=1.6.0"
    },
    "autoload": {
        "psr-4": {
            "ErickComp\\LivewireDataTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "ErickComp\\LivewireDataTable\\ServiceProvider"
            ],
            "dont-discover": []
        }
    },
    "suggest": {
        "laravie/serialize-queries": "Allows Eloquent and Database query builders to be used as data sources for data tables.",
        "openspout/openspout": "Exports data tables to CSV, XLSX and ODS files, writing the rows as they come (^4.0 or ^5.0, recommended for exports).",
        "phpoffice/phpspreadsheet": "Exports data tables to CSV, XLSX and ODS files, building the whole spreadsheet in memory."
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "orchestra/testbench": "^10.0|^11.0",
        "larastan/larastan": "^3.0",
        "laravie/serialize-queries": "^3.3",
        "pestphp/pest-plugin-browser": "^4.3",
        "openspout/openspout": "^5.3",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:browser": "vendor/bin/pest --testsuite=Browser",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
